<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Y4NGZInteractions</AssemblyName>
    <RootNamespace>Y4NGZInteractions</RootNamespace>
    <Description>Consumer-agnostic local animation presentation API for Lethal Company</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableProfileDeploy Condition="'$(EnableProfileDeploy)' == ''">false</EnableProfileDeploy>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Local playtest profile. Derived from the environment so no machine-specific path is
         checked in; override TestProfileRoot (or DeployTarget) to deploy elsewhere. -->
    <TestProfileRoot Condition="'$(TestProfileRoot)' == ''">$(AppData)\com.kesomannen.gale\lethal-company\profiles\Current</TestProfileRoot>
    <BepInExPlugins Condition="'$(BepInExPlugins)' == ''">$(TestProfileRoot)\BepInEx\plugins</BepInExPlugins>
    <!-- A mod manager names a locally imported package's plugin directory after the package,
         so a re-imported profile holds `Y4NGZInteractions` where an older one holds the
         hand-made `y4ngz-Y4NGZInteractions`. Deploying into the directory the profile does not
         load from is silent: BepInEx keeps running the other copy and the build looks applied.
         Prefer the directory that exists, newest layout first. -->
    <DeployTarget Condition="'$(DeployTarget)' == '' and Exists('$(BepInExPlugins)\Y4NGZInteractions')">$(BepInExPlugins)\Y4NGZInteractions</DeployTarget>
    <DeployTarget Condition="'$(DeployTarget)' == ''">$(BepInExPlugins)\y4ngz-Y4NGZInteractions</DeployTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="HarmonyX" Version="2.10.2" PrivateAssets="all" />
    <PackageReference Include="LethalCompany.GameLibs.Steam" Version="81.0.5-ngd.0" Publicize="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <Target Name="GenerateBuildVersionSource" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GeneratedBuildVersionFile>$(IntermediateOutputPath)Y4NGZInteractions.BuildVersion.g.cs</GeneratedBuildVersionFile>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(GeneratedBuildVersionFile)"
      Lines="namespace Y4NGZInteractions { internal static class BuildVersion { internal const string Value = &quot;$(Y4NGZInteractionsVersion)&quot;%3B } }"
      Overwrite="true"
      Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(GeneratedBuildVersionFile)" />
    </ItemGroup>
  </Target>

  <Target Name="DeployToProfile"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(EnableProfileDeploy)' == 'true' and '$(DeployTarget)' != ''">
    <MakeDir Directories="$(DeployTarget)" />
    <ItemGroup>
      <Y4NGZInteractionsDeployFiles Include="$(TargetPath)" />
      <Y4NGZInteractionsDeployFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(Y4NGZInteractionsDeployFiles)" DestinationFolder="$(DeployTarget)" SkipUnchangedFiles="false" />
    <Message Text="Deployed Y4NGZInteractions to: $(DeployTarget)" Importance="high" />
  </Target>
</Project>
