<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Y4NGZInteractions</AssemblyName>
    <RootNamespace>Y4NGZInteractions</RootNamespace>
    <Description>Consumer-agnostic interaction animation API for Lethal Company</Description>
    <Version>0.3.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Lethal Company\Lethal Company_Data\Managed</GameManagedDir>
    <!-- Local playtest profile. Derived from the environment so no machine-specific path is
         checked in; override TestProfileRoot (or DeployTarget) to deploy elsewhere. -->
    <TestProfileRoot Condition="'$(TestProfileRoot)' == ''">$(AppData)\com.kesomannen.gale\lethal-company\profiles\terrible</TestProfileRoot>
    <BepInExPlugins Condition="'$(BepInExPlugins)' == ''">$(TestProfileRoot)\BepInEx\plugins</BepInExPlugins>
    <DeployTarget Condition="'$(DeployTarget)' == ''">$(BepInExPlugins)\y4ngz-Y4NGZInteractions</DeployTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" PrivateAssets="all" />
    <PackageReference Include="HarmonyX" Version="2.10.2" PrivateAssets="all" />
    <PackageReference Include="LethalCompany.GameLibs.Steam" Version="81.0.5-ngd.0" Publicize="true" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- This project builds the consumer-agnostic API assembly only. Animation payloads
       (bundles, manifests, finger poses) ship with the consuming mods, not from here. -->
  <Target Name="DeployToGaleProfile" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(DeployTarget)" />
    <ItemGroup>
      <Y4NGZInteractionsDeployFiles Include="$(TargetPath)" />
      <Y4NGZInteractionsDeployFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(Y4NGZInteractionsDeployFiles)" DestinationFolder="$(DeployTarget)" SkipUnchangedFiles="false" />
    <Message Text="Deployed Y4NGZInteractions to: $(DeployTarget)" Importance="high" />
  </Target>

</Project>
